# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for password-based Admin Panel access.
# If left unset, an inline first-run admin setup form allows claiming the admin password securely.
ADMIN_PASSCODE=
